---
import { Icon } from 'astro-icon/components';
import { menu, withBase, locate, type Feature } from '../data/site';

function isLive(f: Feature): boolean {
  return Boolean(f.path && (f.guides?.length ?? 0) > 0);
}

const home = withBase('');
const current = Astro.url.pathname.replace(/\/+$/, '');
const onHome = current === home.replace(/\/+$/, '');

// Which feature (if any) does the current URL map to?
const located = locate(Astro.url.pathname);
const activeId = located?.feature.id;
---

<nav class="rail" aria-label="MuleSoft Agent Fabric">
  <!-- Brand -->
  <a class="rail-brand" href={home}>
    <Icon name="agent-fabric" class="rail-brand-mark" size={22} />
    <span class="rail-brand-text">Agent Fabric</span>
  </a>

  <!-- Search -->
  <div class="rail-search">
    <Icon name="search" class="rail-search-icon" size={16} />
    <input
      id="rail-search-input"
      type="search"
      placeholder="Search"
      aria-label="Filter navigation"
      autocomplete="off"
    />
    <kbd class="rail-search-kbd">/</kbd>
  </div>

  <div class="rail-scroll" id="rail-scroll">
    <!-- Home -->
    <ul class="rail-top">
      <li>
        <a href={home} class={`rail-item ${onHome ? 'active' : ''}`} data-label="home">
          <Icon name="house" class="rail-icon" size={20} />
          <span class="rail-label">Home</span>
        </a>
      </li>
    </ul>

    {
      menu.map((group) => (
        <div class="rail-group">
          <p class="rail-group-title">{group.group}</p>
          <ul>
            {group.features.map((feature) =>
              feature.children ? (
                <li class="rail-parent">
                  <span class="rail-item rail-item--parent" title={feature.name} data-label={feature.name}>
                    <Icon name="chevron-right" class="rail-chevron" size={14} />
                    {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                    <span class="rail-label">{feature.name}</span>
                  </span>
                  <ul class="rail-children">
                    {feature.children.map((child) => (
                      <li>
                        {isLive(child) ? (
                          <a
                            href={withBase(child.path!)}
                            class={`rail-item ${activeId === child.id ? 'active' : ''}`}
                            title={child.name}
                            data-label={child.name}
                          >
                            {child.icon && <Icon name={child.icon} class="rail-icon" size={20} />}
                            <span class="rail-label">{child.name}</span>
                            <span class="rail-count">{child.guides!.length}</span>
                          </a>
                        ) : (
                          <span class="rail-item rail-item--soon" title={`${child.name} — coming soon`} data-label={child.name}>
                            {child.icon && <Icon name={child.icon} class="rail-icon" size={20} />}
                            <span class="rail-label">{child.name}</span>
                            <span class="rail-soon">Soon</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  {isLive(feature) ? (
                    <a
                      href={withBase(feature.path!)}
                      class={`rail-item ${activeId === feature.id ? 'active' : ''}`}
                      title={feature.name}
                      data-label={feature.name}
                    >
                      {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                      <span class="rail-label">{feature.name}</span>
                      <span class="rail-count">{feature.guides!.length}</span>
                    </a>
                  ) : (
                    <span class="rail-item rail-item--soon" title={`${feature.name} — coming soon`} data-label={feature.name}>
                      {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                      <span class="rail-label">{feature.name}</span>
                      <span class="rail-soon">Soon</span>
                    </span>
                  )}
                </li>
              )
            )}
          </ul>
        </div>
      ))
    }
  </div>

  <!-- Footer -->
  <div class="rail-foot">
    <div class="rail-foot-bar">
      <span class="rail-avatar" aria-hidden="true">AF</span>
      <button id="theme-toggle" class="rail-icon-btn" type="button" aria-label="Toggle color theme">
        <span class="theme-icon theme-icon--sun" aria-hidden="true">☀</span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">☾</span>
      </button>
      <button
        id="rail-toggle"
        class="rail-icon-btn rail-collapse"
        type="button"
        aria-label="Collapse navigation"
        aria-pressed="false"
      >
        <Icon name="arrow-bar-left" class="rail-toggle-icon rail-toggle-icon--collapse" size={18} />
        <Icon name="arrow-bar-right" class="rail-toggle-icon rail-toggle-icon--expand" size={18} />
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    // Collapse / expand the rail.
    const btn = document.getElementById('rail-toggle');
    const sync = () => {
      const collapsed = document.documentElement.classList.contains('nav-collapsed');
      if (!btn) return;
      btn.setAttribute('aria-pressed', String(collapsed));
      btn.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
    };
    btn?.addEventListener('click', () => {
      const collapsed = document.documentElement.classList.toggle('nav-collapsed');
      try {
        localStorage.setItem('navCollapsed', collapsed ? '1' : '0');
      } catch (e) {}
      sync();
    });
    sync();

    // Theme toggle.
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });

    // Filter nav items as you type.
    const input = document.getElementById('rail-search-input');
    const scroll = document.getElementById('rail-scroll');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      scroll?.querySelectorAll('.rail-item[data-label]').forEach((el) => {
        const label = (el.getAttribute('data-label') || '').toLowerCase();
        const li = el.closest('li');
        if (li) li.style.display = !q || label.includes(q) ? '' : 'none';
      });
      // Hide a group whose items are all hidden.
      scroll?.querySelectorAll('.rail-group').forEach((g) => {
        const visible = g.querySelectorAll('li:not([style*="display: none"])').length;
        g.style.display = visible ? '' : 'none';
      });
    });
    // "/" focuses search.
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input?.focus();
      }
    });
  })();
</script>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 256px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border-right: 1px solid var(--border);
    padding: 1rem 0.75rem 0.75rem;
    font-size: 0.9rem;
    transition: width 0.18s ease;
  }
  :global(html.nav-collapsed) .rail {
    width: 68px;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  /* Brand */
  .rail-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    padding: 0.25rem 0.5rem 0.9rem;
  }
  .rail-brand:hover {
    text-decoration: none;
  }
  .rail-brand-mark {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* Search */
  .rail-search {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }
  .rail-search-icon {
    position: absolute;
    left: 0.6rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  .rail-search input {
    width: 100%;
    padding: 0.5rem 0.6rem 0.5rem 2rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
  }
  .rail-search input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .rail-search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .rail-search-kbd {
    position: absolute;
    right: 0.55rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0 0.35rem;
    line-height: 1.4;
    background: var(--bg-soft);
  }

  /* Scroll region */
  .rail-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    margin: 0 -0.25rem;
    padding: 0 0.25rem;
  }
  .rail ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .rail-top {
    margin-bottom: 0.75rem;
  }
  .rail-group + .rail-group {
    margin-top: 0.9rem;
  }
  .rail-group-title {
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: var(--accent);
    font-weight: 650;
    margin: 0 0 0.3rem;
    padding: 0 0.55rem;
  }
  .rail-children {
    margin-top: 0.05rem;
  }

  /* Items */
  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    border-radius: 8px;
    color: var(--text-soft);
    white-space: nowrap;
    line-height: 1.3;
  }
  a.rail-item:hover {
    background: var(--bg-soft);
    color: var(--text);
    text-decoration: none;
  }
  .rail-item.active {
    background: var(--accent-wash);
    color: var(--accent);
    font-weight: 600;
  }
  .rail-item.active .rail-icon {
    color: var(--accent);
  }
  .rail-item--parent {
    color: var(--text);
    font-weight: 550;
    cursor: default;
    padding-left: 0.3rem;
  }
  .rail-chevron {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .rail-children .rail-item {
    padding-left: 1.9rem;
  }
  .rail-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  a.rail-item:hover .rail-icon {
    color: var(--text);
  }
  .rail-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rail-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-wash);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    min-width: 1.4rem;
    text-align: center;
  }
  .rail-item--soon {
    color: var(--text-muted);
    cursor: default;
  }
  .rail-item--soon .rail-icon {
    opacity: 0.6;
  }
  .rail-soon {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.02rem 0.4rem;
  }

  /* Footer */
  .rail-foot {
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
    margin-top: 0.5rem;
  }
  .rail-ext {
    color: var(--text-soft);
  }
  .rail-foot-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.15rem 0.35rem 0;
  }
  .rail-avatar {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    margin-right: auto;
  }
  .rail-icon-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
  }
  .rail-icon-btn:hover {
    background: var(--bg-soft);
    color: var(--text);
  }
  .theme-icon--moon {
    display: none;
  }
  :global(html.dark) .theme-icon--sun {
    display: none;
  }
  :global(html.dark) .theme-icon--moon {
    display: inline;
  }
  .rail-toggle-icon--expand {
    display: none;
  }

  /* ---------- Collapsed (icon-only) state ---------- */
  :global(html.nav-collapsed) .rail-brand-text,
  :global(html.nav-collapsed) .rail-search,
  :global(html.nav-collapsed) .rail-label,
  :global(html.nav-collapsed) .rail-count,
  :global(html.nav-collapsed) .rail-soon,
  :global(html.nav-collapsed) .rail-chevron,
  :global(html.nav-collapsed) .rail-group-title,
  :global(html.nav-collapsed) .rail-avatar {
    display: none;
  }
  :global(html.nav-collapsed) .rail-brand,
  :global(html.nav-collapsed) .rail-item {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    gap: 0;
  }
  :global(html.nav-collapsed) .rail-children .rail-item {
    padding-left: 0;
  }
  :global(html.nav-collapsed) .rail-group + .rail-group {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  :global(html.nav-collapsed) .rail-foot-bar {
    flex-direction: column;
    gap: 0.3rem;
  }
  :global(html.nav-collapsed) .rail-toggle-icon--collapse {
    display: none;
  }
  :global(html.nav-collapsed) .rail-toggle-icon--expand {
    display: inline;
  }

  /* ---------- Mobile: rail sits on top, no full-height column ---------- */
  @media (max-width: 860px) {
    .rail {
      position: static;
      height: auto;
      width: 100%;
      max-height: 60vh;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    :global(html.nav-collapsed) .rail {
      width: 100%;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
    /* On mobile, ignore the collapsed state and always show labels. */
    :global(html.nav-collapsed) .rail-brand-text,
    :global(html.nav-collapsed) .rail-search,
    :global(html.nav-collapsed) .rail-label,
    :global(html.nav-collapsed) .rail-count,
    :global(html.nav-collapsed) .rail-group-title,
    :global(html.nav-collapsed) .rail-avatar {
      display: revert;
    }
    :global(html.nav-collapsed) .rail-item {
      justify-content: flex-start;
      gap: 0.6rem;
    }
    .rail-collapse {
      display: none;
    }
  }
</style>
