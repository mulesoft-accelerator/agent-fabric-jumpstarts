---
import { Icon } from 'astro-icon/components';
import { menu, withBase, type Feature } from '../data/site';

interface Props {
  /** id of the currently active feature (highlighted). */
  activeId?: string;
}
const { activeId } = Astro.props;

function isLive(f: Feature): boolean {
  return Boolean(f.path && (f.guides?.length ?? 0) > 0);
}
---

<nav class="rail" aria-label="MuleSoft Agent Fabric">
  <div class="rail-head">
    <Icon name="agent-fabric" class="rail-mark" size={22} />
    <span class="rail-title">Agent Fabric</span>
  </div>

  <div class="rail-scroll">
    {
      menu.map((group) => (
        <div class="rail-group">
          <p class="rail-group-title">{group.group}</p>
          <ul>
            {group.features.map((feature) =>
              feature.children ? (
                <li class="rail-parent">
                  <span class="rail-item rail-item--parent" title={feature.name}>
                    {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                    <span class="rail-label">{feature.name}</span>
                  </span>
                  <ul class="rail-children">
                    {feature.children.map((child) => (
                      <li>
                        {isLive(child) ? (
                          <a
                            href={withBase(child.path!)}
                            class={`rail-item ${activeId === child.id ? 'active' : ''}`}
                            title={child.name}
                          >
                            {child.icon && <Icon name={child.icon} class="rail-icon" size={20} />}
                            <span class="rail-label">{child.name}</span>
                            <span class="rail-count">{child.guides!.length}</span>
                          </a>
                        ) : (
                          <span class="rail-item rail-item--soon" title={`${child.name} — coming soon`}>
                            {child.icon && <Icon name={child.icon} class="rail-icon" size={20} />}
                            <span class="rail-label">{child.name}</span>
                            <span class="rail-soon">Soon</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  {isLive(feature) ? (
                    <a
                      href={withBase(feature.path!)}
                      class={`rail-item ${activeId === feature.id ? 'active' : ''}`}
                      title={feature.name}
                    >
                      {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                      <span class="rail-label">{feature.name}</span>
                      <span class="rail-count">{feature.guides!.length}</span>
                    </a>
                  ) : (
                    <span class="rail-item rail-item--soon" title={`${feature.name} — coming soon`}>
                      {feature.icon && <Icon name={feature.icon} class="rail-icon" size={20} />}
                      <span class="rail-label">{feature.name}</span>
                      <span class="rail-soon">Soon</span>
                    </span>
                  )}
                </li>
              )
            )}
          </ul>
        </div>
      ))
    }
  </div>

  <button
    id="rail-toggle"
    class="rail-toggle"
    type="button"
    aria-label="Collapse navigation"
    aria-pressed="false"
  >
    <Icon name="arrow-bar-left" class="rail-toggle-icon rail-toggle-icon--collapse" size={20} />
    <Icon name="arrow-bar-right" class="rail-toggle-icon rail-toggle-icon--expand" size={20} />
    <span class="rail-toggle-label">Collapse</span>
  </button>
</nav>

<script is:inline>
  (function () {
    const btn = document.getElementById('rail-toggle');
    if (!btn) return;
    const sync = () => {
      const collapsed = document.documentElement.classList.contains('nav-collapsed');
      btn.setAttribute('aria-pressed', String(collapsed));
      btn.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
    };
    btn.addEventListener('click', () => {
      const collapsed = document.documentElement.classList.toggle('nav-collapsed');
      try {
        localStorage.setItem('navCollapsed', collapsed ? '1' : '0');
      } catch (e) {}
      sync();
    });
    sync();
  })();
</script>

<style>
  .rail {
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .rail-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    padding: 0 0.6rem 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .rail-mark {
    color: var(--accent);
    flex-shrink: 0;
  }
  .rail-scroll {
    flex: 1;
    min-height: 0;
  }
  .rail-group + .rail-group {
    margin-top: 1.1rem;
  }
  .rail-group-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    font-weight: 650;
    margin: 0 0 0.35rem;
    padding: 0 0.6rem;
    opacity: 0.85;
  }
  .rail ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .rail-children {
    margin-top: 0.1rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
    margin-left: 1.15rem;
  }
  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 10px;
    color: var(--text-soft);
    white-space: nowrap;
  }
  a.rail-item:hover {
    background: var(--bg-soft);
    color: var(--text);
    text-decoration: none;
  }
  .rail-item.active {
    background: var(--accent-wash);
    color: var(--accent);
    font-weight: 600;
  }
  .rail-item.active .rail-icon {
    color: var(--accent);
  }
  .rail-item--parent {
    color: var(--text);
    font-weight: 550;
    cursor: default;
  }
  .rail-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  a.rail-item:hover .rail-icon {
    color: var(--text);
  }
  .rail-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rail-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-wash);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    min-width: 1.4rem;
    text-align: center;
  }
  .rail-item--soon {
    color: var(--text-muted);
    cursor: default;
  }
  .rail-item--soon .rail-icon {
    opacity: 0.6;
  }
  .rail-soon {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.02rem 0.4rem;
  }

  /* Collapse toggle */
  .rail-toggle {
    margin-top: 0.75rem;
    padding: 0.5rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    border: none;
    background: none;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    font: inherit;
    border-radius: 0;
  }
  .rail-toggle:hover {
    color: var(--text);
  }
  .rail-toggle-icon {
    flex-shrink: 0;
  }
  .rail-toggle-icon--expand {
    display: none;
  }
  .rail-toggle-label {
    font-size: 0.85rem;
  }

  /* ---------- Collapsed (icon-only) state ---------- */
  :global(html.nav-collapsed) .rail-title,
  :global(html.nav-collapsed) .rail-label,
  :global(html.nav-collapsed) .rail-count,
  :global(html.nav-collapsed) .rail-soon,
  :global(html.nav-collapsed) .rail-group-title,
  :global(html.nav-collapsed) .rail-toggle-label {
    display: none;
  }
  :global(html.nav-collapsed) .rail-head,
  :global(html.nav-collapsed) .rail-item,
  :global(html.nav-collapsed) .rail-toggle {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    gap: 0;
  }
  :global(html.nav-collapsed) .rail-children {
    margin-left: 0;
    padding-left: 0;
    border-left: none;
  }
  :global(html.nav-collapsed) .rail-group + .rail-group {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  :global(html.nav-collapsed) .rail-toggle-icon--collapse {
    display: none;
  }
  :global(html.nav-collapsed) .rail-toggle-icon--expand {
    display: inline;
  }
</style>
