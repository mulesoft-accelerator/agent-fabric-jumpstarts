---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  /** Highlights the matching feature in the rail (rail self-detects too). */
  activeId?: string;
  /** Footer suffix, e.g. "Model Wallets". */
  footerLabel?: string;
}
const { title, description, footerLabel } = Astro.props;
---

<BaseLayout title={title} description={description} footerLabel={footerLabel}>
  <slot />
</BaseLayout>
