---
import { Icon } from 'astro-icon/components';
import { site, withBase } from '../data/site';
import AppRail from '../components/AppRail.astro';

interface Props {
  title?: string;
  description?: string;
  /** Optional suffix for the footer, e.g. "Model Wallets". */
  footerLabel?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const pageDescription = description ?? site.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />

    <!-- Apply the saved theme + nav state before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        if (localStorage.getItem('navCollapsed') === '1') {
          document.documentElement.classList.add('nav-collapsed');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="app">
      <AppRail />
      <main id="main" class="app-main">
        <div class="app-page">
          <slot />
        </div>
      </main>
    </div>

    <button class="assistant" type="button" aria-label="Ask the assistant">
      <Icon name="sparkles" size={22} />
    </button>

    <style is:global>
      /* Theme tokens mirror MuleSoft Omni's SLDS palette (src/index.css there):
         brand blue #0176d3, SLDS neutrals, SF Pro system stack, 16px radius. */
      :root {
        --bg: #ffffff;
        --bg-soft: #f3f3f3; /* SLDS gray-50 */
        --bg-elevated: #ffffff;
        --panel: #f4f6fb; /* tinted overview panel (Omni) */
        --border: #e5e5e5; /* gray-200 */
        --border-strong: #c9c9c9; /* gray-300 */
        --text: #1e1e1e; /* gray-900 */
        --text-soft: #444444; /* gray-700 */
        --text-muted: #757575; /* gray-500 */
        --accent: #0176d3; /* SLDS brand blue */
        --accent-soft: #0b5cab; /* hover */
        --accent-active: #014486; /* active */
        --accent-contrast: #ffffff;
        --accent-wash: #eef4ff; /* blue-50 */
        --code-bg: #f3f3f3;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.18);
        --radius: 16px; /* SLDS default */
        --radius-sm: 12px;
        --maxw: 1180px;
        --font: system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro', 'Helvetica Neue', Arial,
          sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono',
          monospace;
      }

      html.dark {
        --bg: #141414; /* gray-950 */
        --bg-soft: #1e1e1e; /* gray-900 */
        --bg-elevated: #1e1e1e; /* gray-900 */
        --panel: #1a1d24; /* tinted overview panel */
        --border: #444444; /* gray-700 */
        --border-strong: #5c5c5c; /* gray-600 */
        --text: #f3f3f3; /* gray-50 */
        --text-soft: #c9c9c9; /* gray-300 */
        --text-muted: #aeaeae; /* gray-400 */
        --accent: #1b96ff; /* blue-400 for contrast on dark */
        --accent-soft: #57adff;
        --accent-active: #1b96ff;
        --accent-contrast: #ffffff;
        --accent-wash: #032d60; /* blue-800 */
        --code-bg: #1e1e1e;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 2rem;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--accent-contrast);
        padding: 0.5rem 1rem;
        border-radius: 0 0 8px 0;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }

      /* ---------- App shell ---------- */
      .app {
        display: flex;
        align-items: flex-start;
        min-height: 100vh;
      }
      .app-main {
        flex: 1;
        min-width: 0;
      }
      .app-page {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 2rem 2.5rem 4rem;
        width: 100%;
      }

      /* Floating assistant button (decorative, matches Omni) */
      .assistant {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        width: 52px;
        height: 52px;
        border-radius: 999px;
        border: none;
        background: var(--accent);
        color: var(--accent-contrast);
        display: grid;
        place-items: center;
        cursor: pointer;
        box-shadow: var(--shadow-lg);
        z-index: 40;
        transition: transform 0.12s ease, background 0.12s ease;
      }
      .assistant:hover {
        transform: translateY(-2px);
        background: var(--accent-soft);
      }

      @media (max-width: 860px) {
        .app {
          flex-direction: column;
        }
        .app-page {
          padding: 1.5rem 1.25rem 3rem;
        }
      }
    </style>
  </body>
</html>
