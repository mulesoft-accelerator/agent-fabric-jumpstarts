---
import BaseLayout from './BaseLayout.astro';
import { withBase, locate } from '../data/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Frontmatter {
  title?: string;
  description?: string;
}

// Astro passes these props to a markdown file's layout.
const { frontmatter, headings = [] } = Astro.props as {
  frontmatter: Frontmatter;
  headings: Heading[];
};

const current = Astro.url.pathname.replace(/\/$/, '');
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Where does this guide live in the Agent Fabric taxonomy?
const found = locate(Astro.url.pathname);
const feature = found?.feature;
const siblings = feature?.guides ?? [];
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  footerLabel={feature?.name}
>
  <div class="doc-shell wrap">
    <!-- Left: guide navigation -->
    <aside class="doc-sidebar" aria-label="Guides">
      <nav>
        <a class="all-guides" href={withBase('')}>← All guides</a>
        <div class="nav-section">
          {
            feature?.path ? (
              <a class="nav-title nav-title--link" href={withBase(feature.path)}>
                {found?.parent ? `${found.parent.name} · ` : ''}
                {feature?.name}
              </a>
            ) : (
              <p class="nav-title">{feature?.name}</p>
            )
          }
          <ul>
            {siblings.map((item) => {
              const href = withBase(item.href);
              const active = current === href.replace(/\/$/, '');
              return (
                <li>
                  <a href={href} class={active ? 'active' : ''}>
                    {item.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </nav>
    </aside>

    <!-- Center: the rendered markdown -->
    <article id="main" class="doc-main prose">
      <slot />
    </article>

    <!-- Right: on-this-page -->
    {
      toc.length > 0 && (
        <aside class="doc-toc" aria-label="On this page">
          <p class="nav-title">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'toc-sub' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .doc-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    gap: 2.5rem;
    padding-bottom: 1rem;
    align-items: start;
  }

  .doc-sidebar,
  .doc-toc {
    position: sticky;
    top: 2rem;
    align-self: start;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }

  .all-guides {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.4rem;
  }
  .all-guides:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .nav-section + .nav-section {
    margin-top: 1.4rem;
  }
  .nav-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 650;
    margin: 0 0 0.6rem;
    display: block;
  }
  .nav-title--link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .doc-sidebar ul,
  .doc-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .doc-sidebar a,
  .doc-toc a {
    display: block;
    color: var(--text-soft);
    padding: 0.32rem 0.6rem;
    border-radius: 8px;
    border-left: 2px solid transparent;
  }
  .doc-sidebar a:hover,
  .doc-toc a:hover {
    background: var(--bg-soft);
    color: var(--text);
    text-decoration: none;
  }
  .doc-sidebar a.active {
    color: var(--accent);
    background: var(--accent-wash);
    font-weight: 550;
  }
  .doc-toc .toc-sub a {
    padding-left: 1.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .doc-shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .doc-toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .doc-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .doc-sidebar {
      position: static;
      max-height: none;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      background: var(--bg-soft);
    }
  }
</style>

<!-- Prose styles for the rendered markdown. Global so they reach slotted HTML. -->
<style is:global>
  .prose {
    max-width: 46rem;
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose h1 {
    font-size: 2.1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .prose h2 {
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    margin: 2.6rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .prose h3 {
    font-size: 1.15rem;
    margin: 2rem 0 0.75rem;
  }
  .prose p,
  .prose li {
    color: var(--text-soft);
  }
  .prose ul,
  .prose ol {
    padding-left: 1.3rem;
  }
  .prose li {
    margin: 0.3rem 0;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin: 1.25rem 0;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  /* Inline + block code */
  .prose :not(pre) > code {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    color: var(--text);
  }
  .prose pre {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--mono);
  }

  /* Blockquotes -> friendly "note" callouts */
  .prose blockquote {
    margin: 1.25rem 0;
    padding: 0.85rem 1.1rem;
    background: var(--accent-wash);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-soft);
  }
  .prose blockquote > :first-child {
    margin-top: 0;
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.92rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .prose thead th {
    background: var(--bg-soft);
    color: var(--text);
    font-weight: 600;
  }
  .prose tbody tr:last-child td {
    border-bottom: none;
  }

  /* Class-based dark mode for Shiki dual themes. */
  html.dark .astro-code,
  html.dark .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
</style>
